{
  "name": "dsh-tavern-adventure",
  "version": "0.2.0",
  "description": "Local script-driven dungeon adventures for DSH: DM sessions, independent NPC agents, and isolated saves.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./core": "./lib/core.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "demo", "docs", "scripts", "cordis.patch.yml", "README.md", "LICENSE"],
  "author": "leonardwwq",
  "repository": { "type": "git", "url": "git+https://github.com/leonardwwq/dsh-tavern.git" },
  "homepage": "https://github.com/leonardwwq/dsh-tavern#readme",
  "bugs": { "url": "https://github.com/leonardwwq/dsh-tavern/issues" },
  "keywords": ["deepseek-harness", "dsh", "tavern", "text-adventure", "npc", "roleplay", "文字冒险", "地下城"],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "prepack": "npm run check && npm run build:demo"
  },
  "dependencies": {
    "dsh-cultivation": "^0.4.1",
    "fflate": "^0.8.2",
    "yaml": "^2.8.1"
  },
  "bundleDependencies": ["dsh-cultivation"],
  "engines": {"node": ">=22"},
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {"platform": "web"}
  },
  "license": "MIT"
}
